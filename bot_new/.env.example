# =====================================================
# CẤU HÌNH CRYPTO NEWS BOT
# Sao chép file này thành .env và điền thông tin thực
# =====================================================

# ─── BINANCE AUTO TRADE (TÙY CHỌN) ───────────────

# API Key & Secret Binance Futures — tạo tại: Binance > Profile > API Management
# Cần bật quyền: "Enable Futures" (KHÔNG bật Withdraw)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Bật auto đặt lệnh thực trên Binance Futures (mặc định: false — chỉ gửi alert)
# Đặt true để bot tự động vào lệnh khi AI ra signal
TRADE_ENABLED=false

# % số dư USDT dùng cho mỗi lệnh khi balance > $100 (mặc định: 20%)
# Tiered sizing:
#   balance > $100  → dùng TRADE_SIZE_PCT% (tối đa TRADE_MAX_USDT)
#   balance ≤ $100  → flat $20/lệnh (hằng số FLAT_TRADE_USDT trong code, không cấu hình qua env)
TRADE_SIZE_PCT=20

# Số USDT tối đa mỗi lệnh — giới hạn an toàn dù balance lớn (mặc định: 30 USDT)
TRADE_MAX_USDT=30

# ─── BẮT BUỘC ─────────────────────────────────────

# Cấu hình AI: Chọn 'claude' hoặc 'gemini' (để trống: tự động nhận diện theo key)
AI_PROVIDER=claude

# Anthropic Claude AI (Khuyên dùng cho trading bot)
# - Key chính thức: lấy tại https://console.anthropic.com (bắt đầu bằng sk-ant-...)
# - Key qua proxy / OneAPI: điền key và cấu hình thêm CLAUDE_BASE_URL bên dưới
CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_BASE_URL=https://api.your-proxy-domain.com/v1
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# Hoặc Google Gemini AI (Miễn phí 500 req/ngày):
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot — gửi bản tin và alert
# Tạo bot: nhắn /newbot cho @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot riêng cho kênh tin tức (tuỳ chọn) — để trống: dùng chung TELEGRAM_BOT_TOKEN
TELEGRAM_NEWS_BOT_TOKEN=

# Chat ID nhận tin: kênh công khai (@ten_kenh) hoặc riêng tư (-100xxxxxxxxxx)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── API KEY TUỲ CHỌN ─────────────────────────────

# CryptoCompare — nguồn tin tức crypto (JSON API)
# Đăng ký miễn phí: https://www.cryptocompare.com/cryptopian/api-keys
# Để trống: bot vẫn dùng RSS (CoinDesk, CoinTelegraph, Decrypt) thay thế
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# Whale Alert — theo dõi giao dịch on-chain lớn
# Đăng ký free: https://whale-alert.io (500 req/ngày, dữ liệu 1h gần nhất)
# Để trống: bot vẫn chạy bình thường, OKX taker flow vẫn hoạt động
WHALE_ALERT_API_KEY=your_whale_alert_key_here

# Coinalyze — OI + L/S ratio + liquidations tổng hợp từ 15+ sàn (Binance, OKX, Bybit...)
# Đăng ký MIỄN PHÍ: https://coinalyze.net (40 req/phút)
# Để trống: bot dùng Bybit (OI/L-S) + Binance (liquidations) thay thế
COINALYZE_API_KEY=your_coinalyze_api_key_here

# ─── LỊCH CHẠY ────────────────────────────────────

# Lịch gửi bản tin thị trường đầy đủ (mặc định: 4 tiếng/lần — 0h,4h,8h,12h,16h,20h VN)
# Định dạng cron: "phút giờ ngày tháng thứ"
CRON_SCHEDULE=0 */4 * * *

# Múi giờ hiển thị và tính lịch cron
TIMEZONE=Asia/Ho_Chi_Minh

# Lịch signal scan — tìm lệnh mới giữa các bản tin (mặc định: mỗi 5 phút)
# Lưu ý: không nên chạy quá thường xuyên, tốn Gemini quota và Coinalyze rate limit
SIGNAL_SCAN_CRON=*/5 * * * *

# ─── ALERT GIÁ BTC ────────────────────────────────

# Gửi alert khi BTC thay đổi >= X$ so với giá BTC_ALERT_WINDOW phút trước (mặc định: $1000)
BTC_ALERT_USD=1000

# Cửa sổ thời gian so sánh giá — lấy giá BTC cách đây X phút để tính biến động (mặc định: 15)
BTC_ALERT_WINDOW=15

# Thời gian chờ tối thiểu giữa 2 BTC alert liên tiếp — đơn vị phút (mặc định: 30)
# Tăng nếu bị spam alert khi thị trường biến động mạnh
BTC_ALERT_COOLDOWN=30

# ─── PHÂN TÍCH COINS ──────────────────────────────

# Danh sách coin luôn được phân tích TA đầy đủ dù market cap hay trend thế nào
# Định dạng: viết hoa, cách nhau bởi dấu phẩy, không có khoảng trắng thừa
FIXED_COINS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA

# Danh sách coin vốn hoá lớn, thanh khoản cao — ngưỡng score bằng FIXED_COINS (≥ MIN_SCORE_TRADE)
# Coin trong list này sẽ KHÔNG bị lọc bởi MIN_SCORE_EXTRA của LIQUID/GAINERS
# Thêm/bớt tuỳ ý, không cần có trong top CoinGecko
TIER2_COINS=LTC,AVAX,LINK,ATOM,DOT,NEAR

# Số coin liquid nhất ngoài FIXED_COINS được thêm vào phân tích (mặc định: 10)
# Lấy từ CoinGecko top 20, loại stablecoin và coin đã có trong FIXED_COINS
MAX_EXTRA_COINS=10

# Số coin tăng mạnh nhất (top gainers 24h) được thêm vào — bắt trend mới nổi (mặc định: 10)
MAX_GAINER_COINS=10

# Tổng số coin tối đa cho TA + Whale mỗi chu kỳ (mặc định: 20)
# Coinalyze cho phép tối đa 20 symbol/request — không nên vượt quá 20
MAX_TA_COINS=20

# ─── TIN TỨC & PHÂN TÍCH AI ──────────────────────────────

# Bật/tắt thu thập tin tức crypto (mặc định: true)
# false → bỏ qua getCryptoNews, AI không có ngữ cảnh tin tức
NEWS_ENABLED=true

# Bật/tắt phân tích thị trường bằng Gemini AI (mặc định: true)
# false → không gọi Gemini, không gửi tin phân tích, signal scan bị bỏ qua hoàn toàn
AI_ANALYSIS_ENABLED=true

# Chat ID kênh nhận bản tin thị trường + phân tích AI
# Để trống: dùng TELEGRAM_CHAT_ID (channel chính)
# Kênh công khai: @ten_kenh_phan_tich | Kênh riêng tư: -100xxxxxxxxxx
TELEGRAM_NEWS_CHAT_ID=

# ─── NGƯỠNG ĐIỂM CONFLUENCE ───────────────────────

# Điểm tối thiểu để signal scan (5 phút) gọi Gemini AI (mặc định: 7)
# Tăng → ít tốn Gemini quota, bỏ lỡ cơ hội sớm
# Giảm → gọi AI thường hơn, tốn quota, nhiều nhiễu
MIN_SCORE_SIGNAL=7

# Điểm tối thiểu để chấp nhận lệnh AI khuyến nghị vào danh sách theo dõi (mặc định: 7)
# Nên >= MIN_SCORE_SIGNAL để tránh theo dõi lệnh chất lượng thấp
MIN_SCORE_TRADE=7

# Điểm tối thiểu cho coin LIQUID CAO và GAINERS (mặc định: 8 — cao hơn FIXED/TIER2)
# Tăng → chỉ trade các setup rất rõ ràng từ coin mới nổi
# Giảm → chấp nhận coin liquid/gainers dễ hơn, tiệm cận FIXED_COINS
MIN_SCORE_EXTRA=8

# Điểm tối thiểu để cho phép đảo chiều lệnh đang active (mặc định: 9 = BEST_OPPORTUNITY)
# Cao hơn MIN_SCORE_TRADE vì đảo chiều rủi ro hơn: phải cắt lỗ + vào lệnh ngược
MIN_SCORE_REVERSAL=9

# ─── BẢO VỆ LỆNH ACTIVE ──────────────────────────

# Số giờ tối thiểu phải giữ lệnh trước khi AI được phép đề xuất đảo chiều (mặc định: 8)
# Ngăn flip-flop liên tục khi thị trường dao động trong vùng hẹp
MIN_HOLD_HOURS_REVERSAL=8

# Thay đổi % tối thiểu để bot chấp nhận cập nhật TP hoặc SL từ AI (mặc định: 1.5)
# Lọc các update vụn vặt do AI làm tròn số hoặc noise
MIN_TP_SL_UPDATE_PCT=1.5

# Số giờ tối đa chờ fill entry — bot tự hủy lệnh nếu giá không về vùng vào lệnh (mặc định: 4)
# Tránh vào lệnh lỗi thời khi thị trường đã đi xa so với thời điểm AI phân tích
ENTRY_EXPIRY_HOURS=4

# ─── BỘ LỌC CHẤT LƯỢNG LỆNH (anti stop-hunt) ────

# Cooldown sau khi đóng lệnh — không vào lại cùng coin trong X giờ (mặc định: 6)
# Ngăn re-entry ngay sau TP/SL khi coin đang ở vùng đã phản ứng
TRADE_COOLDOWN_HOURS=6

# SL tối thiểu = X lần ATR 4h (mặc định: 1.5)
# Dưới ngưỡng này là vùng noise — dễ bị stop-hunt trước khi giá đi đúng hướng
MIN_SL_ATR_MULT=1.5

# R:R tối thiểu = TP% / SL% (mặc định: 1.5)
# Lệnh bị từ chối nếu TP quá hẹp hoặc SL quá rộng so với nhau
MIN_RR_RATIO=1.5

# ─── Dashboard ───────────────────────────────────────────────────────────────
# Port cho web dashboard (mặc định: 3000)
DASHBOARD_PORT=3000
